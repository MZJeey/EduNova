@model EduNova.web.ViewModels.ViewModelLogin
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduNova</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-pulse.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduNova.web.styles.css" asp-append-version="true" />

    <!-- Toast -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">

    <!-- SweetAlert -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.4/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary: #13a4ec;
            --primary-dark: #0d8bc7;
            --bg-gradient: radial-gradient(circle at top, #13a4ec 0, #0b1b2a 45%, #050911 100%);
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-wrapper {
            width: 100%;
            max-width: 960px;
            padding: 1.5rem;
        }

        .login-card {
            border-radius: 1.25rem;
            overflow: hidden;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
            border: none;
            background: rgba(255, 255, 255, 0.97);
        }

        /* Lado izquierdo con branding */
        .login-hero {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #fff;
            padding: 2.5rem 2rem;
            position: relative;
            height: 100%;
        }

            .login-hero::before {
                content: "";
                position: absolute;
                inset: 12%;
                border-radius: 1.75rem;
                border: 1px solid rgba(255,255,255,0.20);
                opacity: 0.45;
            }

        .login-hero-content {
            position: relative;
            z-index: 1;
        }

        .login-logo {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid rgba(255,255,255,0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            background: rgba(0,0,0,0.15);
        }

            .login-logo img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .login-title {
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: 0.03em;
        }

        .login-subtitle {
            font-size: 0.95rem;
            opacity: 0.9;
        }

        .login-badges {
            margin-top: 1.75rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .login-badge {
            padding: 0.35rem 0.9rem;
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.18);
            font-size: 0.75rem;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
        }

        /* Lado derecho: formulario */
        .login-form-side {
            padding: 2.25rem 2.25rem 2rem 2.25rem;
        }

        .login-form-header {
            margin-bottom: 1.5rem;
        }

            .login-form-header h2 {
                font-weight: 700;
                font-size: 1.4rem;
                margin-bottom: 0.25rem;
            }

            .login-form-header p {
                margin: 0;
                font-size: 0.9rem;
                color: #6c757d;
            }

        .form-label-custom {
            font-weight: 600;
            font-size: 0.9rem;
            color: #495057;
        }

        .form-control-custom {
            border-radius: 0.6rem;
            border: 1px solid #dee2e6;
            padding: 0.65rem 0.9rem;
            font-size: 0.92rem;
            transition: all 0.2s ease;
        }

            .form-control-custom:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 0.2rem rgba(19, 164, 236, 0.25);
            }

        .btn-login {
            border-radius: 999px;
            font-weight: 600;
            padding: 0.65rem 1rem;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border: none;
        }

            .btn-login:hover {
                filter: brightness(1.05);
                transform: translateY(-1px);
            }

        .login-footer-text {
            font-size: 0.8rem;
            color: #868e96;
        }

        .loading {
            display: inline-block;
            border: 3px solid rgba(0,0,0,0.1);
            border-top: 3px solid var(--primary);
            border-radius: 50%;
            width: 1.6rem;
            height: 1.6rem;
            animation: spin 0.7s linear infinite;
        }

        .loadingXXXX {
            display: none;
        }

        @@keyframes spin {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }

        @@media (max-width: 767.98px) {
            .login-hero

        {
            display: none;
        }

        .login-card {
            border-radius: 1rem;
        }

        .login-form-side {
            padding: 2rem 1.5rem 1.5rem 1.5rem;
        }

        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="card login-card">
            <div class="row g-0">
                <!-- Lado izquierdo: branding -->
                <div class="col-md-5 d-none d-md-block">
                    <div class="login-hero">
                        <div class="login-hero-content">
                            <div class="login-logo">
                                <img src="~/images/eduNova.jpg" alt="EduNova" />
                            </div>
                            <div class="mb-2">
                                <span class="badge bg-light text-dark fw-semibold mb-2">
                                    <i class="bi bi-lightning-charge-fill me-1"></i> EduNova 
                                </span>
                            </div>
                            <h1 class="login-title mb-2">Bienvenido de vuelta</h1>
                            <p class="login-subtitle">
                                Gestiona incidencias, cursos y tickets de soporte desde un solo lugar.
                                Accede con tus credenciales institucionales.
                            </p>

                            <div class="login-badges">
                                <span class="login-badge">
                                    <i class="bi bi-shield-lock-fill"></i>
                                    Seguridad por roles
                                </span>
                                <span class="login-badge">
                                    <i class="bi bi-people-fill"></i>
                                    Admin · Docente · Técnico
                                </span>
                                <span class="login-badge">
                                    <i class="bi bi-graph-up"></i>
                                    Seguimiento en tiempo real
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Lado derecho: formulario -->
                <div class="col-md-7">
                    <div class="login-form-side">
                        <div class="login-form-header text-center mb-4">
                            <h2>Iniciar sesión</h2>
                            <p>Ingresa tu correo y contraseña para acceder a EduNova.</p>
                        </div>

                        <form asp-controller="Login" asp-action="LogIn" method="post" asp-antiforgery="true">
                            <div class="mb-3">
                                <label asp-for="User" class="form-label-custom">
                                    <i class="bi bi-envelope-fill me-1 text-primary"></i>Correo electrónico
                                </label>
                                <input asp-for="User" class="form-control form-control-custom" type="text" autocomplete="username" />
                                <span asp-validation-for="User" class="text-danger small"></span>
                            </div>

                            <div class="mb-2">
                                <label asp-for="Password" class="form-label-custom">
                                    <i class="bi bi-lock-fill me-1 text-primary"></i>Contraseña
                                </label>
                                <input asp-for="Password" class="form-control form-control-custom" type="password" autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <small class="login-footer-text">
                                    Usa la contraseña asignada por el administrador.
                                </small>
                            </div>

                            <div class="d-grid mb-3">
                                <button class="btn btn-login text-white" type="submit" onclick="spinnerEffect()">
                                    <span class="me-2"><i class="bi bi-box-arrow-in-right"></i></span>
                                    Iniciar sesión
                                </button>
                            </div>

                            <!-- Spinner -->
                            <div class="text-center mb-2">
                                <div id="loader" class="loadingXXXX" role="status"></div>
                            </div>

                            @if (ViewBag.Message != null)
                            {
                                <div class="alert alert-danger py-2 small" role="alert" id="message">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    @ViewBag.Message
                                </div>
                            }
                        </form>

                        <div class="text-center mt-3">
                            <span class="login-footer-text">
                                &copy; @DateTime.Now.Year - EduNova · Panel de gestión académica
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        function spinnerEffect() {
            console.log("spinnerEffect");
            const loader = document.getElementById("loader");
            if (loader) {
                loader.className = "loading";
            }
        }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Ajax unobtrusive -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ajax-unobtrusive/3.2.6/jquery.unobtrusive-ajax.js"
            integrity="sha512-f04GBpoqEZhbyjlRTuXeg8FIHDb+xfCJ0LVdqiN1fEl5B3jz3Z0SPe9IxDumOVdTeeXmKMcMJhb26VuGf1Laqw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <!-- Toast -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.4/dist/sweetalert2.all.min.js"></script>

    @if (ViewBag.NotificationMessage != null)
    {
        <script>
            @Html.Raw(ViewBag.NotificationMessage)
        </script>
    }
</body>
</html>

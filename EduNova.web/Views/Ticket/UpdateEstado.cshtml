@model EduNova.Application.DTOs.TicketDTO

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>EduNova - Actualizar Estado del Ticket</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <script>
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                "primary": "#13a4ec",
                "background-light": "#f6f7f8",
                "background-dark": "#101c22",
                "slate": {
                  50: '#f8fafc',
                  100: '#f1f5f9',
                  200: '#e2e8f0',
                  300: '#cbd5e1',
                  400: '#94a3b8',
                  500: '#64748b',
                  600: '#475569',
                  700: '#334155',
                  800: '#1e293b',
                  900: '#0f172a'
                }
              },
              fontFamily: {
                "display": ["Manrope"]
              },
              borderRadius: {
                "DEFAULT": "0.25rem",
                "lg": "0.5rem",
                "xl": "0.75rem",
                "full": "9999px"
              },
            },
          },
        }
    </script>
</head>
<body class="bg-background-light dark:bg-slate-900 font-display">
    <!-- Modal de actualización de estado -->
    <div class="fixed inset-0 bg-black bg-opacity-50 dark:bg-opacity-70 flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg w-full max-w-md m-4">
            <form asp-action="UpdateEstado" method="post">
                <div class="p-6">
                    <div class="flex justify-between items-start">
                        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Actualizar Estado del Ticket</h3>
                        <a asp-action="Index" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300">
                            <span class="material-symbols-outlined">close</span>
                        </a>
                    </div>
                    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Seleccione un nuevo estado para el ticket. El cambio se registrará automáticamente.</p>

                    <div class="mt-6">
                        <div class="mb-4">
                            <label asp-for="IdTicket" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">ID del Ticket</label>
                            <input asp-for="IdTicket" class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 focus:ring-primary focus:border-primary" readonly />
                            <span asp-validation-for="IdTicket" class="text-red-500 text-xs mt-1"></span>
                        </div>

                        <div>
                            <label asp-for="Estado" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Nuevo Estado</label>
                            <select asp-for="Estado" class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-primary focus:border-primary">
                                <option value="">-- Selecciona Estado --</option>
                                <option value="Abierto">Abierto</option>
                                <option value="En Proceso">En Proceso</option>
                                <option value="Cerrado">Cerrado</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-red-500 text-xs mt-1"></span>
                        </div>
                    </div>
                </div>

                <div class="bg-slate-50 dark:bg-slate-800/50 px-6 py-4 flex justify-end gap-3 rounded-b-xl">
                    <a asp-action="Index" class="py-2 px-4 rounded-lg text-sm font-medium bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-600">Cancelar</a>
                    <button type="submit" class="py-2 px-4 rounded-lg text-sm font-medium bg-primary text-white hover:bg-primary/90">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>

@model EduNova.Application.DTOs.TicketDTO

<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"/>
<link crossorigin="" href="https://fonts.gstatic.com/" rel="preconnect"/>
<link as="style" href="https://fonts.googleapis.com/css2?display=swap&amp;family=Manrope%3Awght%40400%3B500%3B700%3B800" onload="this.rel='stylesheet'" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#1f2937", // A darker gray for primary text
                        "primary-dark": "#ffffff",
                        "background-light": "#ffffff", // Pure white background
                        "background-dark": "#111827", // Dark gray for dark mode
                        "border-light": "#e5e7eb",
                        "border-dark": "#374151",
                        "muted-light": "#6b7280",
                        "muted-dark": "#9ca3af",
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "0.75rem",
                        "xl": "1rem",
                        "full": "9999px"
                    },
                },
            },
            darkMode: "class"
        }
    </script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
<title>Detalles del Ticket</title>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-gray-800 dark:text-gray-200">
<div class="flex min-h-screen w-full flex-col">
<main class="flex-1 px-4 py-10 sm:px-6 lg:px-8">
<div class="mx-auto max-w-5xl">
<div class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
<div>
<h1 class="text-3xl font-bold text-primary dark:text-primary-dark">Detalles del Ticket</h1>
<p class="mt-1 text-sm text-muted-light dark:text-muted-dark">Visualiza la información completa del ticket seleccionado.</p>
</div>
                    <a href="@Url.Action("Index")" class="flex items-center gap-2 rounded-lg border border-border-light dark:border-border-dark px-4 py-2 text-sm font-medium text-primary dark:text-primary-dark hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
<span class="material-symbols-outlined text-base">arrow_back</span>
                    Volver al Listado
                </a>
</div>
<div class="overflow-hidden rounded-lg border border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark shadow-sm">
<div class="p-6 md:p-8">
<div class="grid grid-cols-1 gap-x-12 gap-y-8 md:grid-cols-2">
<div>
<h3 class="mb-6 text-xl font-semibold text-primary dark:text-primary-dark">Información General</h3>
<dl class="space-y-5">
<div class="flex flex-col sm:flex-row sm:justify-between">
<dt class="text-sm font-medium text-muted-light dark:text-muted-dark">ID del Ticket</dt>
<dd class="text-sm text-primary dark:text-primary-dark font-medium mt-1 sm:mt-0">

                                            @Html.DisplayFor(model => model.IdTicket)
</dd>
</div>
<div class="flex flex-col sm:flex-row sm:justify-between">
<dt class="text-sm font-medium text-muted-light dark:text-muted-dark">Título</dt>
<dd class="text-sm text-primary dark:text-primary-dark font-medium mt-1 sm:mt-0 text-left sm:text-right">

                                            @Html.DisplayFor(model => model.Titulo)
</dd>
</div>
<div class="flex flex-col sm:flex-row sm:justify-between">
<dt class="text-sm font-medium text-muted-light dark:text-muted-dark">Estado</dt>
<dd class="mt-1 sm:mt-0"><span class="inline-flex items-center rounded-full bg-green-100 dark:bg-green-900/50 px-2.5 py-0.5 text-xs font-semibold text-green-800 dark:text-green-300">
                                                @Html.DisplayFor(model => model.Estado)
                                            </span></dd>
</div>
<div class="flex flex-col sm:flex-row sm:justify-between">
<dt class="text-sm font-medium text-muted-light dark:text-muted-dark">Prioridad</dt>
<dd class="mt-1 sm:mt-0"><span class="inline-flex items-center rounded-full bg-red-100 dark:bg-red-900/50 px-2.5 py-0.5 text-xs font-semibold text-red-800 dark:text-red-300">
                                                @Html.DisplayFor(model => model.Prioridad)

                                            </span></dd>
</div>
<div class="flex flex-col sm:flex-row sm:justify-between">
<dt class="text-sm font-medium text-muted-light dark:text-muted-dark">Fecha de Creación</dt>
<dd class="text-sm text-primary dark:text-primary-dark font-medium mt-1 sm:mt-0">
                                            @Html.DisplayFor(model => model.FechaCreacion)

</dd>
</div>
<div class="flex flex-col sm:flex-row sm:justify-between">
<dt class="text-sm font-medium text-muted-light dark:text-muted-dark">Fecha de Cierre</dt>
                                        <dd class="text-sm text-muted-light dark:text-muted-dark mt-1 sm:mt-0"> @Html.DisplayFor(model => model.FechaCierre)</dd>
</div>
</dl>
</div>
<div>
<h3 class="mb-6 text-xl font-semibold text-primary dark:text-primary-dark">Detalles Adicionales</h3>
<dl class="space-y-5">
<div class="flex flex-col sm:flex-row sm:justify-between">
<dt class="text-sm font-medium text-muted-light dark:text-muted-dark">Categoría</dt>
<dd class="text-sm text-primary dark:text-primary-dark font-medium mt-1 sm:mt-0">
                                            @Html.DisplayFor(model => model.NombreCategoria)
</dd>
</div>
<div class="flex flex-col sm:flex-row sm:justify-between">
<dt class="text-sm font-medium text-muted-light dark:text-muted-dark">SLA</dt>
                                        <dd class="text-sm text-primary dark:text-primary-dark font-medium mt-1 sm:mt-0"> @Html.DisplayFor(model => model.NombreSla)</dd>
</div>
<div class="flex flex-col sm:flex-row sm:justify-between">
<dt class="text-sm font-medium text-muted-light dark:text-muted-dark">Solicitante</dt>
                                        <dd class="text-sm text-primary dark:text-primary-dark font-medium mt-1 sm:mt-0"> @Html.DisplayFor(model => model.NombreSolicitante)</dd>
</div>
<div class="flex flex-col sm:flex-row sm:justify-between">
<dt class="text-sm font-medium text-muted-light dark:text-muted-dark">Valoración</dt>
                                        <dd class="text-sm text-muted-light dark:text-muted-dark mt-1 sm:mt-0"> @Html.DisplayFor(model => model.valoracion)</dd>
</div>
</dl>
</div>
</div>
<div class="mt-8 border-t border-border-light dark:border-border-dark pt-8">
<h3 class="mb-3 text-xl font-semibold text-primary dark:text-primary-dark">Descripción</h3>
                            <p class="text-sm text-muted-light dark:text-muted-dark leading-relaxed"> @Html.DisplayFor(model => model.Descripcion)</p>
</div>



@* Estado historial *@
               <div class="mt-8 border-t border-border-light dark:border-border-dark pt-8">
                            <h3 class="mb-4 text-xl font-semibold text-primary dark:text-primary-dark">Historial del Ticket</h3>

                            @if (Model.HistorialTickets != null && Model.HistorialTickets.Any())
                            {
                                <div class="overflow-hidden rounded-lg border border-border-light dark:border-border-dark shadow-sm">
                                    <table class="min-w-full divide-y divide-border-light dark:divide-border-dark">
                                        <thead class="bg-gray-50 dark:bg-gray-800">
                                            <tr>
                                                <th scope="col" class="px-4 py-2 text-left text-xs font-semibold text-muted-light dark:text-muted-dark uppercase tracking-wider">Fecha Cambio</th>
                                                <th scope="col" class="px-4 py-2 text-left text-xs font-semibold text-muted-light dark:text-muted-dark uppercase tracking-wider">Estado</th>
                                                <th scope="col" class="px-4 py-2 text-left text-xs font-semibold text-muted-light dark:text-muted-dark uppercase tracking-wider">Comentario</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-border-light dark:divide-border-dark bg-background-light dark:bg-background-dark">
                                            @foreach (var historial in Model.HistorialTickets)
                                            {
                                                <tr>
                                                    <td class="px-4 py-2 text-sm text-primary dark:text-primary-dark">
                                                        @historial.FechaCambio.ToString("dd/MM/yyyy HH:mm")
                                                    </td>
                                                    <td class="px-4 py-2">
                                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold
                                            @(historial.EstadoTickets == "Cerrado" ? "bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300" :
                                                                                                    historial.EstadoNuevo == "En Proceso" ? "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/50 dark:text-yellow-300" :
                                                                                                    "bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300")">
                                                    @historial.EstadoTickets
                                                </span>
                                            </td>
                                            <td class="px-4 py-2 text-sm text-muted-light dark:text-muted-dark">@historial.observaciones</td>
                                        </tr>
                                                                                }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-sm text-muted-light dark:text-muted-dark">No hay historial registrado para este ticket.</p>
                            }
                        </div>

                        @* FIN *@

<div class="mt-8 border-t border-border-light dark:border-border-dark pt-8">
<h3 class="mb-4 text-xl font-semibold text-primary dark:text-primary-dark">Imágenes Adjuntas</h3>
<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">

<div class="group relative">


                                    @if (Model.Imagenes != null && Model.Imagenes.Any())
                                    {
                                        <ul>
                                            @foreach (var imagen in Model.Imagenes)
                                            {
                                                <div class="aspect-w-1 aspect-h-1 w-full overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800">
                                                    <img src="@imagen.Url" class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-105" />
                                                </div>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No hay imágenes adjuntas</span>
                                    }

</div>
</div>
</div>
</div>
<div class="flex items-center justify-end gap-4 border-t border-border-light dark:border-border-dark bg-gray-50 dark:bg-gray-900/50 px-6 py-4">
<button class="rounded-lg h-10 px-5 text-sm font-bold text-white bg-primary dark:bg-primary-dark dark:text-primary hover:bg-gray-700 dark:hover:bg-gray-200 transition-colors">
                        Editar Ticket
                    </button>
</div>
</div>
</div>
</main>
</div>

</body></html>
